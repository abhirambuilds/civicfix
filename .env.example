# ==============================================================================
# CivicFix Environment Variables Template
# Copy this file to .env (for backend) and frontend/.env.local (for frontend)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Database (Supabase PostgreSQL via Prisma)
# Pooled connection string (Transaction mode, typically port 6543)
DATABASE_URL=
# Direct connection string (Session mode, typically port 5432, used for migrations)
DIRECT_URL=

# Supabase Storage & Services
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq Issue Intelligence (server-side only; never expose this key to the browser)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Authentication (Custom JWT + bcrypt)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Database Demo Seed Passwords (Required by `npm run db:seed`)
# Set these locally before running the seed script. NEVER commit real values.
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_ORG_OWNER_PASSWORD=
SEED_ORG_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_USER_PASSWORD=

# AI Intelligence Integrations (Used in future prompts)
GEMINI_API_KEY=
