{
  "name": "civicfix-backend",
  "version": "1.0.0",
  "description": "CivicFix REST API Backend - Issue Reporting & Multi-Organization Resolution Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:validate": "tsx src/scripts/validatePrisma.ts",
    "test:db": "tsx src/scripts/testDbConnection.ts",
    "test:auth": "tsx src/scripts/testAuth.ts",
    "test:rbac": "tsx src/scripts/testRbac.ts",
    "test:org": "tsx src/scripts/testOrganization.ts",
    "test:dept": "tsx src/scripts/testDepartment.ts",
    "test:issue": "tsx src/scripts/testIssue.ts",
    "test:storage": "tsx src/scripts/testStorage.ts",
    "test:org-issues": "tsx src/scripts/testPrompt17.ts",
    "test:workflow": "tsx src/scripts/testPrompt18.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "civicfix",
    "express",
    "typescript",
    "rest-api",
    "prisma",
    "jwt",
    "auth"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
