// ==============================================================================
// CivicFix - Prisma Schema
// Database: Supabase PostgreSQL
// Synchronized from: supabase/schema.sql (Source of Truth)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// ENUMS (1:1 Mapping to PostgreSQL Enums)
// ==============================================================================

enum UserRole {
  PLATFORM_ADMIN
  ORG_OWNER
  ORG_ADMIN
  MANAGER
  STAFF
  USER

  @@map("user_role")
}

enum OrganizationType {
  UNIVERSITY
  MUNICIPALITY
  CORPORATION
  RESIDENTIAL_ASSOCIATION
  OTHER

  @@map("organization_type")
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  MEMBER

  @@map("org_member_role")
}

enum IssueStatus {
  REPORTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("issue_status")
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("issue_priority")
}

enum BoundaryType {
  POLYGON
  BOUNDING_BOX
  RADIUS

  @@map("boundary_type")
}

enum AiAgentType {
  ISSUE_INTELLIGENCE
  SMART_ROUTING
  DUPLICATE_DETECTION
  IMAGE_VERIFICATION

  @@map("ai_agent_type")
}

enum AiAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("ai_analysis_status")
}

enum NotificationType {
  ISSUE_CREATED
  ISSUE_ASSIGNED
  STATUS_CHANGED
  REMARK_ADDED
  ISSUE_RESOLVED

  @@map("notification_type")
}

// ==============================================================================
// MODELS (1:1 Mapping to PostgreSQL Tables)
// ==============================================================================

/// 1. users - Registered users across all tenant organizations and platform
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organizationMembers OrganizationMember[]
  departmentMembers   DepartmentMember[]
  reportedIssues      Issue[]              @relation("IssueReporter")
  assignedIssues      IssueAssignment[]    @relation("AssignedUser")
  createdAssignments  IssueAssignment[]    @relation("AssignmentCreatedBy")
  comments            IssueComment[]
  statusChanges       IssueStatusHistory[]
  notifications       Notification[]

  @@index([role], map: "idx_users_role")
  @@index([isActive], map: "idx_users_is_active")
  @@map("users")
}

/// 2. organizations - Tenant organizations (SRM Campus Admin, Municipalities, etc.)
model Organization {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(255)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.Text
  orgType     OrganizationType @default(OTHER) @map("org_type")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  members      OrganizationMember[]
  departments  Department[]
  categories   IssueCategory[]
  serviceAreas OrganizationServiceArea[]
  routingRules RoutingRule[]
  issues       Issue[]

  @@index([slug], map: "idx_organizations_slug")
  @@index([isActive], map: "idx_organizations_is_active")
  @@map("organizations")
}

/// 3. organization_members - Membership mappings between users and organizations
model OrganizationMember {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  orgRole        OrgMemberRole @default(MEMBER) @map("org_role")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "uq_organization_members")
  @@index([userId], map: "idx_org_members_user_id")
  @@index([organizationId], map: "idx_org_members_org_id")
  @@map("organization_members")
}

/// 4. departments - Internal operational divisions within organizations
model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  code           String?  @db.VarChar(50)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members          DepartmentMember[]
  routingRules     RoutingRule[]
  issueAssignments IssueAssignment[]

  @@unique([organizationId, name], map: "uq_department_name_per_org")
  @@index([organizationId], map: "idx_departments_org_id")
  @@map("departments")
}

/// 5. department_members - Staff assignments within specific departments
model DepartmentMember {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId     String   @map("department_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  roleInDepartment String?  @default("STAFF") @map("role_in_department") @db.VarChar(100)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId], map: "uq_department_members")
  @@index([departmentId], map: "idx_dept_members_dept_id")
  @@index([userId], map: "idx_dept_members_user_id")
  @@map("department_members")
}

/// 6. issue_categories - Categorization taxonomy for civic and campus issues
model IssueCategory {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  name            String        @db.VarChar(100)
  slug            String        @db.VarChar(100)
  description     String?       @db.Text
  icon            String?       @db.VarChar(50)
  defaultPriority IssuePriority @default(MEDIUM) @map("default_priority")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routingRules RoutingRule[]
  issues       Issue[]

  @@index([organizationId], map: "idx_categories_org_id")
  @@map("issue_categories")
}

/// 7. organization_service_areas - Geographic boundaries for automatic tenant routing
model OrganizationServiceArea {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String       @db.VarChar(255)
  boundaryType    BoundaryType @default(POLYGON) @map("boundary_type")
  minLatitude     Float?       @map("min_latitude")
  maxLatitude     Float?       @map("max_latitude")
  minLongitude    Float?       @map("min_longitude")
  maxLongitude    Float?       @map("max_longitude")
  centerLatitude  Float?       @map("center_latitude")
  centerLongitude Float?       @map("center_longitude")
  radiusKm        Float?       @map("radius_km")
  boundaryGeojson Json         @map("boundary_geojson")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_service_areas_org_id")
  @@index([minLatitude, maxLatitude, minLongitude, maxLongitude], map: "idx_service_areas_bbox")
  @@map("organization_service_areas")
}

/// 8. routing_rules - Deterministic rules mapping categories & keywords to departments
model RoutingRule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  categoryId       String?        @map("category_id") @db.Uuid
  departmentId     String         @map("department_id") @db.Uuid
  overridePriority IssuePriority? @map("override_priority")
  keywords         String[]
  ruleOrder        Int            @default(0) @map("rule_order")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     IssueCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, ruleOrder], map: "idx_routing_rules_org_order")
  @@index([categoryId], map: "idx_routing_rules_category_id")
  @@index([departmentId], map: "idx_routing_rules_dept_id")
  @@map("routing_rules")
}

/// 9. issues - Core civic issue reports and status tracking
model Issue {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueNumber    String        @unique @map("issue_number") @db.VarChar(50)
  reporterId     String        @map("reporter_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  title          String        @db.VarChar(255)
  description    String        @db.Text
  status         IssueStatus   @default(REPORTED)
  priority       IssuePriority @default(MEDIUM)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz(6)

  // Relations
  reporter      User                 @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category      IssueCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location      IssueLocation?
  images        IssueImage[]
  assignments   IssueAssignment[]
  comments      IssueComment[]
  statusHistory IssueStatusHistory[]
  aiAnalyses    AiAnalysis[]
  notifications Notification[]

  @@index([reporterId], map: "idx_issues_reporter_id")
  @@index([organizationId], map: "idx_issues_organization_id")
  @@index([categoryId], map: "idx_issues_category_id")
  @@index([status], map: "idx_issues_status")
  @@index([priority], map: "idx_issues_priority")
  @@index([createdAt(sort: Desc)], map: "idx_issues_created_at_desc")
  @@index([organizationId, status], map: "idx_issues_org_status")
  @@index([organizationId, categoryId], map: "idx_issues_org_category")
  @@map("issues")
}

/// 10. issue_locations - Geolocation coordinates of reported issues (1-to-1)
model IssueLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId   String   @unique @map("issue_id") @db.Uuid
  latitude  Float
  longitude Float
  address   String?  @db.Text
  landmark  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId], map: "idx_issue_locations_issue_id")
  @@index([latitude, longitude], map: "idx_issue_locations_lat_lon")
  @@map("issue_locations")
}

/// 11. issue_images - Photographic evidence references stored in Supabase Storage
model IssueImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  storagePath String   @map("storage_path") @db.VarChar(1000)
  fileName    String   @map("file_name") @db.VarChar(255)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  fileSize    Int?     @map("file_size")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId], map: "idx_issue_images_issue_id")
  @@map("issue_images")
}

/// 12. issue_assignments - Issue delegation history to departments and staff members
model IssueAssignment {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId        String      @map("issue_id") @db.Uuid
  departmentId   String?     @map("department_id") @db.Uuid
  assignedUserId String?     @map("assigned_user_id") @db.Uuid
  assignedById   String      @map("assigned_by_id") @db.Uuid
  notes          String?     @db.Text
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  issue        Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedUser User?       @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedBy   User        @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([issueId], map: "idx_issue_assignments_issue_id")
  @@index([departmentId], map: "idx_issue_assignments_dept_id")
  @@index([assignedUserId], map: "idx_issue_assignments_user_id")
  @@index([isActive], map: "idx_issue_assignments_is_active")
  @@map("issue_assignments")
}

/// 13. issue_comments - Internal remarks and public resolution comments
model IssueComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  commentText String   @map("comment_text") @db.Text
  isInternal  Boolean  @default(false) @map("is_internal")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt(sort: Asc)], map: "idx_issue_comments_issue_created")
  @@map("issue_comments")
}

/// 14. issue_status_history - Immutable audit log of all issue status changes
model IssueStatusHistory {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId        String       @map("issue_id") @db.Uuid
  previousStatus IssueStatus? @map("previous_status")
  newStatus      IssueStatus  @map("new_status")
  changedById    String       @map("changed_by_id") @db.Uuid
  remark         String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt(sort: Asc)], map: "idx_issue_status_history_issue")
  @@map("issue_status_history")
}

/// 15. ai_analyses - Asynchronous AI agent results (Issue Intelligence, Smart Routing)
model AiAnalysis {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId          String           @map("issue_id") @db.Uuid
  agentType        AiAgentType      @map("agent_type")
  status           AiAnalysisStatus @default(PENDING)
  modelProvider    String?          @map("model_provider") @db.VarChar(100)
  modelName        String?          @map("model_name") @db.VarChar(100)
  confidence       Decimal?         @db.Decimal(5, 4)
  rawOutput        Json?            @map("raw_output")
  structuredResult Json?            @map("structured_result")
  errorMessage     String?          @map("error_message") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)

  // Relations
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId], map: "idx_ai_analyses_issue_id")
  @@index([agentType, status], map: "idx_ai_analyses_agent_status")
  @@map("ai_analyses")
}

/// 16. notifications - User notification records for issue lifecycle events
model Notification {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId      String           @map("recipient_id") @db.Uuid
  issueId          String?          @map("issue_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  title            String           @db.VarChar(255)
  message          String           @db.Text
  isRead           Boolean          @default(false) @map("is_read")
  readAt           DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  issue     Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt(sort: Desc)], map: "idx_notifications_recipient_read")
  @@map("notifications")
}
